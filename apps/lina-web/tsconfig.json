{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "#/*": ["src/*"],
      "@douyinfe/semi-icons/*": ["node_modules/@douyinfe/semi-icons/*"],
      "@douyinfe/semi-ui/*": ["node_modules/@douyinfe/semi-ui/*"],
      "@linapro/plugin-ui/rich-text-editor": ["src/plugin-ui/rich-text-public.ts"],
      "@linapro/plugin-ui": ["src/plugin-ui/public.ts"],
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom": ["node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["node_modules/@types/react-dom/*"],
      "zustand": ["node_modules/zustand"],
      "zustand/*": ["node_modules/zustand/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src", "build", "vite.config.ts", "eslint.config.js"]
}
