{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "#/*": ["src/*"],
      "@douyinfe/semi-icons/*": ["node_modules/@douyinfe/semi-icons/*"],
      "@douyinfe/semi-ui/*": ["node_modules/@douyinfe/semi-ui/*"],
      "@linapro/plugin-ui/rich-text-editor": ["src/plugin-ui/rich-text-public.ts"],
      "@linapro/plugin-ui": ["src/plugin-ui/public.ts"],
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom": ["node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["node_modules/@types/react-dom/*"],
      "zustand": ["node_modules/zustand"],
      "zustand/*": ["node_modules/zustand/*"]
    }
  },
  "include": [
    "src/plugin-ui/public.ts",
    "../lina-plugins/linapro-ai-core/frontend/**/*.ts",
    "../lina-plugins/linapro-ai-core/frontend/**/*.tsx",
    "../lina-plugins/linapro-content-notice/frontend/**/*.ts",
    "../lina-plugins/linapro-content-notice/frontend/**/*.tsx",
    "../lina-plugins/linapro-demo-source/frontend/**/*.ts",
    "../lina-plugins/linapro-demo-source/frontend/**/*.tsx",
    "../lina-plugins/linapro-monitor-loginlog/frontend/**/*.ts",
    "../lina-plugins/linapro-monitor-loginlog/frontend/**/*.tsx",
    "../lina-plugins/linapro-monitor-online/frontend/**/*.ts",
    "../lina-plugins/linapro-monitor-online/frontend/**/*.tsx",
    "../lina-plugins/linapro-monitor-operlog/frontend/**/*.ts",
    "../lina-plugins/linapro-monitor-operlog/frontend/**/*.tsx",
    "../lina-plugins/linapro-monitor-server/frontend/**/*.ts",
    "../lina-plugins/linapro-monitor-server/frontend/**/*.tsx",
    "../lina-plugins/linapro-org-core/frontend/**/*.ts",
    "../lina-plugins/linapro-org-core/frontend/**/*.tsx",
    "../lina-plugins/linapro-tenant-core/frontend/**/*.ts",
    "../lina-plugins/linapro-tenant-core/frontend/**/*.tsx"
  ]
}
